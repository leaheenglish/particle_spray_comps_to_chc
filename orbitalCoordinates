def orbpole(x,y,z,vx,vy,vz):
    # r x v in cartesian coordinates!
    pos=np.concatenate((np.reshape(x, (x.size,1)),np.reshape(y, (y.size,1)),np.reshape(z, (z.size,1))), axis = 1)
    vel=np.concatenate((np.reshape(vx, (vx.size,1)),np.reshape(vy, (vy.size,1)),np.reshape(vz, (vz.size,1))), axis = 1)
    uu = np.cross(pos, vel, axis = 1)
    # |r.v|
    uumag = np.linalg.norm(uu, axis = 1)
    u = uu.T/uumag
    #print(pos.shape,vel.shape,uu.shape,uumag.shape, u.shape)
    
    return u

